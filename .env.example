# Copy to .env and fill in. .env is never committed.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=kashvo.in,www.kashvo.in
CSRF_TRUSTED_ORIGINS=https://kashvo.in,https://www.kashvo.in

# --- Site ---
SITE_URL=https://kashvo.in
APP_URL=/app
PHONE=+91 85906 42039

# --- Database: sqlite (local) or mysql (production) ---
DB_ENGINE=mysql
DB_NAME=kashvo_site
DB_USER=kashvo_site
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Files (absolute paths on the server; defaults are website/staticfiles and website/media) ---
# STATIC_ROOT=/home/kashvo/htdocs/kashvo.in/website/staticfiles
# MEDIA_ROOT=/home/kashvo/htdocs/kashvo.in/website/media

# --- Optional ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=WARNING
